generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  username String @unique
  email String @unique
  passwordHash String
  avatar String?
  balance Int @default(0)
  role String @default("USER")
  isBanned Boolean @default(false)
  muteUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastOnline DateTime?
  dailyCaseClaimedAt DateTime?
  inventory Inventory[]
  transactions Transaction[]
  drops Drop[]
  upgrades Upgrade[]
  redemptions PromoRedemption[]
  messages ChatMessage[]
  adminLogs AdminLog[] @relation("AdminActions")
  openings Opening[]
  giveawayEntries GiveawayEntry[]
  wonGiveaways Giveaway[] @relation("GiveawayWinner")
  battlesCreated Battle[] @relation("BattleCreator")
  battlePlayers BattlePlayer[]
  navalGamesCreated NavalGame[] @relation("NavalCreator")
  navalPlayers NavalPlayer[]
}

model Item {
  id String @id
  name String
  wear String
  price Int
  image String
  rarity String
  active Boolean @default(true)
  caseItems CaseItem[]
  inventory Inventory[]
  targetDrops Drop[] @relation("DropItem")
  sourceUpgrades Upgrade[] @relation("UpgradeSource")
  targetUpgrades Upgrade[] @relation("UpgradeTarget")
  giveawayPrizes Giveaway[]
}

model Case {
  id String @id @default(uuid())
  name String
  slug String @unique
  image String
  price Int
  collection String
  active Boolean @default(true)
  items CaseItem[]
  drops Drop[]
  openingStyle String @default("REEL")
  maxOpen Int @default(5)
  contentsHidden Boolean @default(false)
}

model CaseItem {
  id String @id @default(uuid())
  caseId String
  itemId String
  weight Int @default(1)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@unique([caseId, itemId])
}

model Inventory {
  id String @id @default(uuid())
  userId String
  itemId String
  obtainedFrom String
  obtainedAt DateTime @default(now())
  revealed Boolean @default(true)
  removedAt DateTime?
  dropId String? @unique
  upgradeId String? @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])
  @@index([userId, removedAt, revealed])
}

model Transaction {
  id String @id @default(uuid())
  userId String
  type String
  amount Int
  description String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model Drop {
  id String @id @default(uuid())
  userId String
  itemId String
  caseId String
  revealed Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation("DropItem", fields: [itemId], references: [id])
  case Case @relation(fields: [caseId], references: [id])
}

model Opening {
  id String @id @default(uuid())
  userId String
  key String
  response Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
}

model Upgrade {
  id String @id @default(uuid())
  userId String
  sourceItemId String
  targetItemId String
  chance Int
  balanceStake Int @default(0)
  result Boolean
  revealed Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceItem Item @relation("UpgradeSource", fields: [sourceItemId], references: [id])
  targetItem Item @relation("UpgradeTarget", fields: [targetItemId], references: [id])
}

model PromoCode {
  id String @id @default(uuid())
  code String @unique
  rewardType String
  rewardValue String
  maxUses Int
  uses Int @default(0)
  expiresAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id String @id @default(uuid())
  promoId String
  userId String
  redeemedAt DateTime @default(now())
  promo PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([promoId, userId])
}

model ChatMessage {
  id String @id @default(uuid())
  userId String
  message String
  createdAt DateTime @default(now())
  deleted Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminLog {
  id String @id @default(uuid())
  adminId String
  action String
  targetUserId String?
  metadata Json?
  createdAt DateTime @default(now())
  admin User @relation("AdminActions", fields: [adminId], references: [id])
}

model Giveaway {
  id String @id @default(uuid())
  title String
  kind String @default("CUSTOM")
  prizeItemId String
  entryPrice Int
  startsAt DateTime
  endsAt DateTime
  active Boolean @default(true)
  automatic Boolean @default(false)
  winnerUserId String?
  createdAt DateTime @default(now())
  prizeItem Item @relation(fields: [prizeItemId], references: [id])
  winner User? @relation("GiveawayWinner", fields: [winnerUserId], references: [id])
  entries GiveawayEntry[]
  @@index([active, startsAt, endsAt])
}

model GiveawayEntry {
  id String @id @default(uuid())
  giveawayId String
  userId String
  createdAt DateTime @default(now())
  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([giveawayId, userId])
  @@index([giveawayId, createdAt])
}

model Battle {
  id String @id @default(uuid())
  creatorId String
  status String @default("WAITING")
  mode String @default("NORMAL")
  playerLimit Int @default(2)
  private Boolean @default(false)
  inviteCode String @unique
  caseIds Json
  results Json?
  winnerUserId String?
  createdAt DateTime @default(now())
  settledAt DateTime?
  creator User @relation("BattleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  players BattlePlayer[]
  @@index([status, private, createdAt])
}

model BattlePlayer {
  id String @id @default(uuid())
  battleId String
  userId String?
  botName String?
  joinedAt DateTime @default(now())
  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([battleId, userId])
}

model NavalGame {
  id String @id @default(uuid())
  creatorId String
  stake Int
  status String @default("WAITING")
  turnUserId String?
  winnerUserId String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  creator User @relation("NavalCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  players NavalPlayer[]
  @@index([status, createdAt])
}

model NavalPlayer {
  id String @id @default(uuid())
  gameId String
  userId String
  ships Json?
  shots Json @default("[]")
  ready Boolean @default(false)
  game NavalGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([gameId, userId])
}

model SiteSetting {
  key String @id
  value String
  updatedAt DateTime @updatedAt
}
